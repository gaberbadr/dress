# API Port (external port on your machine)
API_PORT=5000

# Database Port (external port on your machine)
DB_PORT=1433

# Database Password (SQL Server)
DB_PASSWORD=Your_password123

# Database Configuration (for Docker Compose)
ConnectionStrings__DefaultConnection=Server=db;Database=Project1;User Id=sa;Password=Your_password123;TrustServerCertificate=True;MultipleActiveResultSets=true;Connection Timeout=30;

# Redis Configuration
ConnectionStrings__REDIS_URL=your_redis_connection_string

# JWT Configuration
JWT__Key=your_super_secret_jwt_key_here
JWT__Issuer=http://localhost:5000/
JWT__Audience=Project1
JWT__AccessTokenExpirationMinutes=15
JWT__RefreshTokenExpirationDays=7

# Email Configuration
Email__Host=smtp.gmail.com
Email__Port=587
Email__SenderEmail=your-email@gmail.com
Email__SenderPassword=your-app-password
Email__SenderDisplayName=Gaber Company
Email__EnableSsl=true
Email__ExpirationMinutes=3

# Google OAuth Configuration
Authentication__Google__ClientId=your_google_client_id
Authentication__Google__ClientSecret=your_google_client_secret

# Cloudinary Configuration
CloudinarySettings__CloudName=your_cloudinary_cloud_name
CloudinarySettings__ApiKey=your_cloudinary_api_key
CloudinarySettings__ApiSecret=your_cloudinary_api_secret

# Redis Cache Settings
CacheSettings__Redis__Enabled=true
CacheSettings__Redis__DefaultExpirationMinutes=1
CacheSettings__Redis__ConnectTimeoutMs=10000
CacheSettings__Redis__SyncTimeoutMs=10000

# Rate Limiting Configuration
RateLimiting__Authenticated__Requests=100
RateLimiting__Authenticated__WindowSeconds=60
RateLimiting__Anonymous__Requests=30
RateLimiting__Anonymous__WindowSeconds=60
RateLimiting__Global__Requests=1000
RateLimiting__Global__WindowSeconds=60
RateLimiting__ClientIdCookieName=X-Client-Id
RateLimiting__ClientIdCookieExpirationDays=30

# Login Rate Limiter Configuration
LoginRateLimiter__MaxAttempts=5
LoginRateLimiter__AttemptWindowMinutes=15
LoginRateLimiter__BanDurationHours=3

# Application URLs
BaseURL=http://localhost:5000

# Frontend Allowed URLs
Frontend__AllowedBaseUrls__0=http://127.0.0.1:5500
Frontend__AllowedBaseUrls__1=http://localhost:3000
Frontend__AllowedBaseUrls__2=http://localhost:5000

# ASP.NET Core Configuration
ASPNETCORE_ENVIRONMENT=Production